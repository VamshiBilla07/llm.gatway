# ---- Server ----
PORT=3000
# Optional: if set, POST /v1/signup requires {"inviteCode": "..."} (protects your free upstream quota)
SIGNUP_CODE=

# ---- Storage (all free) ----
# MongoDB Atlas free M0 cluster. Leave empty to use in-memory storage (data lost on restart).
MONGODB_URI=
# Upstash free Redis (use the rediss:// URL). Leave empty to use in-memory cache + rate limiter.
REDIS_URL=

# ---- Providers (enable any; each needs only a free key) ----
# Order = fallback order. Providers without keys are skipped automatically.
PROVIDER_ORDER=groq,gemini,openrouter,ollama
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Local, no key needed: install Ollama, `ollama pull llama3.2:3b`, then set OLLAMA_ENABLED=1
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://localhost:11434/v1
# Fake provider for demos/tests, needs no key at all
MOCK_PROVIDER=0

# ---- Model overrides (free-tier model names change often: check provider docs) ----
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.3-70b-versatile
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_SMART=gemini-flash-latest
OPENROUTER_MODEL_FAST=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_SMART=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_MODEL_FAST=llama3.2:3b
OLLAMA_MODEL_SMART=llama3.2:3b

# ---- Tuning ----
DEFAULT_RPM=20
DEFAULT_BUDGET_USD=1
CACHE_TTL_SECONDS=3600
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_RETRIES=1
BREAKER_FAILURES=3
BREAKER_COOLDOWN_MS=30000
LOG_RETENTION_DAYS=30
